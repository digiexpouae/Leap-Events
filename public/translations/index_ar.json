  "translations": [
    "قائمة طعام",
    "إنجليزي",
    "ادخل إلى دائرة الضوء\n",
    "نصمم مساحات وفعاليات عالمية المستوى\nتخلق ذكريات، وتطلق\nحوارات، وترتقي بالطموحات.",
